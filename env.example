# ─────────────────────────────────────────────────────────
# Configurações da automação Notion → IA → Anki
# Renomeie este arquivo para .env antes de usar
# ─────────────────────────────────────────────────────────

# Token de integração do Notion
# Obtenha em: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_COLOQUE_SEU_TOKEN_AQUI

# Provedor de IA: claude (padrão) ou gemini
AI_PROVIDER=claude

# Chave da API Anthropic (Claude) — necessária se AI_PROVIDER=claude
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-COLOQUE_SUA_CHAVE_AQUI

# Chave da API Google Gemini — necessária se AI_PROVIDER=gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaCOLOQUE_SUA_CHAVE_AQUI

# Modelo Gemini a usar (padrão: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# URL do AnkiConnect (padrão — não mude a menos que saiba o que faz)
ANKI_HOST=http://localhost:8765
