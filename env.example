# ─────────────────────────────────────────────────────────
# Configurações da automação Notion → IA → Anki
# Renomeie este arquivo para .env antes de usar
# ─────────────────────────────────────────────────────────

# Token de integração do Notion
# Obtenha em: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_COLOQUE_SEU_TOKEN_AQUI

# Provedor de IA: claude | gemini | openai | groq
#   gemini → free tier (Google AI Studio)
#   groq   → free tier generoso (Llama / Mixtral / DeepSeek)
#   openai → pago (ChatGPT)
#   claude → pago (Anthropic)
AI_PROVIDER=gemini

# Chave da API Anthropic (Claude) — necessária se AI_PROVIDER=claude
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-COLOQUE_SUA_CHAVE_AQUI
CLAUDE_MODEL=claude-opus-4-5

# Chave da API Google Gemini — necessária se AI_PROVIDER=gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaCOLOQUE_SUA_CHAVE_AQUI
# Modelo Gemini (free tier ativo nos modelos 2.5)
GEMINI_MODEL=gemini-2.5-flash

# Chave da API OpenAI (ChatGPT) — necessária se AI_PROVIDER=openai
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-COLOQUE_SUA_CHAVE_AQUI
# gpt-4o-mini é o mais barato com qualidade boa
OPENAI_MODEL=gpt-4o-mini

# Chave da API Groq — necessária se AI_PROVIDER=groq
# Obtenha em: https://console.groq.com/keys (free tier disponível)
GROQ_API_KEY=gsk_COLOQUE_SUA_CHAVE_AQUI
# Modelos populares: llama-3.3-70b-versatile, llama-3.1-8b-instant,
#                    mixtral-8x7b-32768, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# URL do AnkiConnect (padrão — não mude a menos que saiba o que faz)
ANKI_HOST=http://localhost:8765

# ─── Tuning avançado (opcional) ────────────────────────────────────────────
# Teto global de flashcards por item. Pode ser sobrescrito por tabela na UI.
MAX_FLASHCARDS_POR_AULA=10

# Notion: número de retries em 429/5xx (rate limit / falha transitória).
NOTION_MAX_RETRIES=4
# Atraso inicial (em segundos) entre retries — dobra a cada tentativa.
NOTION_RETRY_BASE_DELAY=0.5
# Profundidade máxima de recursão em blocos aninhados (proteção anti-ciclo).
MAX_BLOCK_DEPTH=8
